{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latam-market",
  "main": "src/worker.ts",
  // `nodejs_compat` entra por dois motivos concretos: `Buffer` no caminho do replay
  // (`value_inventory` recebe base64) e `node:crypto` na verificação do HMAC da ingestão.
  // Tem que ser uma data que o workerd LOCAL também entenda: o runtime embutido no
  // vitest-pool-workers vai até 2026-08-22, e uma data à frente faz o pool se recusar a
  // subir. Data de compatibilidade é piso, não teto — subir só quando o pool acompanhar.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // O cutover: o domínio passa a ser servido pelo Worker.
  //
  // `custom_domain: true`, e NÃO um route comum. Um route só intercepta o que já passa
  // pela Cloudflare, e o registro estava cinza — apontando direto para 18.231.251.11, com
  // o Caddy respondendo e nenhum `cf-ray` na resposta. Um route ali teria publicado sem
  // erro nenhum e o site continuaria saindo do EC2: deploy verde, nada mudou.
  //
  // Com `custom_domain` o próprio wrangler passa a administrar o registro de DNS, o que
  // SUBSTITUI o A que apontava para o EC2.
  //
  // ⚠ REVERSÃO: não basta tirar daqui. Como o registro passou a ser da Cloudflare, voltar
  // é apagar o domínio personalizado e recriar o A:
  //
  //     mercado.latam-tools.com.br  A  18.231.251.11   (DNS only, nuvem cinza)
  //
  // O endereço fica escrito porque é a única coisa que a reversão precisa saber e que
  // deixa de estar em qualquer lugar assim que o registro é trocado.
  "routes": [{ "pattern": "mercado.latam-tools.com.br", "custom_domain": true }],

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // Equivale ao `try_files {path} /index.html` do Caddy: o roteamento é do cliente
    // (BrowserRouter), então qualquer caminho que não seja arquivo cai no index.
    "not_found_handling": "single-page-application",
    // O equivalente ao `@backend path /api/* /mcp /healthz` que vinha ANTES do
    // `file_server` no Caddy. Sem isto, o `not_found_handling` acima responderia
    // index.html para /api/v1/qualquer-coisa e a API sumiria por baixo da SPA — o mesmo
    // acidente de ordem que deixou a raiz em 404 na 0.3.0, com outro nome.
    "run_worker_first": ["/api/*", "/mcp", "/healthz", "/internal/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latam-market",
      "database_id": "ff2d5093-d0e9-4ee6-8dfa-65350ac5e89d",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "latam-market-snapshots"
    }
  ],

  // De hora em hora fecha o dia corrente e limpa os retratos velhos do R2; uma vez por dia
  // refaz o dia anterior (a última coleta dele pode ter pousado depois das 23h) e varre o
  // histórico vencido. Os dois com intervalo >= 1h, o que dá 15 minutos de CPU cada.
  "triggers": { "crons": ["7 * * * *", "13 0 * * *"] },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Valores que dois módulos capturam em escopo de MÓDULO, antes de existir `env`:
  // `mcp/tools.ts` monta `API_REPLAY_URL` e dimensiona o schema de `get_prices`, e
  // `mcp/server.ts` interpola a URL nas instruções. Como `define` eles continuam
  // constantes de build, que é o que aquele código sempre assumiu.
  "define": {
    "__PUBLIC_URL__": "\"https://mercado.latam-tools.com.br\"",
    "__MAX_BATCH_ITEMS__": "100"
  },

  "vars": {
    // O hostname de *.workers.dev saiu no cutover, como estava previsto: adicionar o
    // domínio personalizado APOSENTA o `latam-market.adsonpleal.workers.dev`, que passou a
    // responder 404 em tudo. Manter um nome morto numa allowlist não é inofensivo — é uma
    // linha que diz "este endereço é nosso" sobre algo que já não é.
    //
    // Foi essa aposentadoria que derrubou a ingestão por sete horas: o shipper ainda
    // apontava o INGEST_URL para lá, então toda coleta terminava, empacotava ~97 mil
    // linhas e levava 404 na entrega. Quem for mexer no domínio de novo: o endereço de
    // ingestão do shipper mora num drop-in na máquina, fora deste repositório.
    "ALLOWED_HOSTS": "mercado.latam-tools.com.br,localhost,127.0.0.1",
    // `visuais` é o simulador de visuais: o catálogo dele filtra por "já visto no mercado"
    // / "à venda agora" com /api/v1/ids, direto do navegador.
    "ALLOWED_ORIGINS": "https://claude.ai,https://mercado.latam-tools.com.br,https://visuais.latam-tools.com.br,http://localhost:5173",
    "MAX_MCP_BODY": "1048576",
    "MAX_REPLAY_BYTES": "8388608",
    "MAX_RESULTS": "100",
    "CRAWL_TRADING_MIN": "30",
    // Cadência por servidor. FREYA carrega ~4x mais linhas que NIDHOGG por ~1,6x as
    // requisições, então não faz sentido os dois esperarem a mesma coisa.
    //
    // ⚠ EM AVALIAÇÃO (2026-09-08). Os 15min de FREYA ficam ACIMA do descanso de uma saída
    // recusada, que é o que derrubou a cadência de 15 hoje de manhã: 4 coletas descartadas
    // e o frescor indo de 3min para 65. A diferença agora é que só FREYA corre esse risco
    // e NIDHOGG saiu da frente. Se voltarem a aparecer coletas descartadas, o caminho de
    // volta é apagar estas duas linhas.
    "CRAWL_TRADING_MIN_FREYA": "15",
    "CRAWL_TRADING_MIN_NIDHOGG": "60"
  }
}
