# Serviço principal: API REST + servidor MCP + agendador do crawl.
#
# Instalar em /etc/systemd/system/latam-market.service, depois:
#   systemctl daemon-reload && systemctl enable --now latam-market
#
# Provisionamento manual necessário uma vez (o deploy NÃO faz):
#   install -d -o ubuntu -g ubuntu /var/lib/latam-market
#   install -d -o ubuntu -g ubuntu /opt/latam-market
#   cp infra/caddy/latam-market.caddy /etc/caddy/conf.d/ && systemctl reload caddy
#
# Quem coleta os dados é um componente à parte, instalado ao lado e apontado por
# COLLECTOR_PATH. Ele traz o próprio drop-in em /etc/systemd/system/latam-market.service.d/
# com o que precisa (inclusive relaxar as restrições daqui). Sem ele, este serviço sobe e
# responde a partir do banco — só não coleta nada novo.

[Unit]
Description=latam-market — API e MCP do mercado do RO LATAM
After=network-online.target
Wants=network-online.target

# Ficam em [Unit], não em [Service]: o systemd ignora com aviso se postos no lugar
# errado. O agendador espalha as coletas com jitter, então um restart em laço não
# vira rajada contra o site; ainda assim, limitar o laço é barato.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/latam-market

Environment=NODE_ENV=production
Environment=PORT=8788
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/latam-market/data
# ⚠ FORA de /opt: o deploy faz `rsync --delete` lá, e levaria o histórico junto.
Environment=DB_PATH=/var/lib/latam-market/market.db
Environment=PUBLIC_URL=https://mercado.latam-tools.com.br
Environment=ALLOWED_HOSTS=mercado.latam-tools.com.br,localhost,127.0.0.1
Environment=ALLOWED_ORIGINS=https://claude.ai,https://mercado.latam-tools.com.br
Environment=CRAWL_ENABLED=1

# O cache do mercado inteiro é dezenas de MB; o teto de heap deixa uma coleta
# descontrolada morrer no worker em vez de a máquina inteira entrar em swap.
ExecStart=/usr/bin/node --max-old-space-size=256 /opt/latam-market/server.mjs

Restart=always
RestartSec=5

# Máquina compartilhada: um vazamento aqui não pode derrubar os vizinhos.
MemoryMax=256M
CPUWeight=50
IOWeight=50
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/latam-market /opt/latam-market/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=latam-market

[Install]
WantedBy=multi-user.target
