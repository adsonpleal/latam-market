# API e MCP do mercado do RO LATAM (latam-market.service, porta 8788) e a interface web
# servida da MESMA origem.
#
# Vai para /etc/caddy/conf.d/latam-market.caddy — o Caddyfile principal é um stub que
# faz `import conf.d/*.caddy`, então cada projeto é dono do seu próprio bloco.
#
# NÃO precisa ser copiado à mão: o infra/apply-caddy-fragment.sh compara este arquivo com
# o que está em /etc/caddy/conf.d/ e, se mudou, valida, recarrega e restaura o anterior se
# a validação falhar. O deploy o chama em todo push. Era manual até a 0.3.0, e a janela
# entre o push e a cópia deixou a raiz em 404.
#
# Para aplicar à mão (numa máquina nova, ou depurando), sem sudo — o script já o pede
# onde precisa:
#   /opt/latam-market/infra/apply-caddy-fragment.sh
#   /opt/latam-market/infra/smoke.sh
# O script valida ANTES de recarregar, e é por isso que existe: este Caddy serve outros
# três sites, e um fragmento inválido derruba todos de uma vez. Rode o smoke DEPOIS — o
# `validate` confere a sintaxe, não a ordem dos `handle`, que é o que mantém a API viva ao
# lado da SPA.
#
# O Caddy não confere se o `root` existe ao carregar: sem /opt/latam-market-web o `/`
# responde 404 até o primeiro deploy da web (a API, o MCP e o /healthz continuam de pé).
# O passo do deploy cria o diretório com um index de espera antes de recarregar, então
# essa janela não existe mais.
mercado.latam-tools.com.br {
	# Antes só JSON; agora também o HTML/CSS/JS da interface. `text/event-stream` fica
	# de FORA de propósito: se o transporte MCP passar a usar SSE, comprimir o stream
	# anularia o flush incremental. Campos `header` repetidos dentro de um `match` são
	# OU, não E.
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type text/css*
			header Content-Type text/html*
			header Content-Type image/svg+xml*
		}
	}

	# O upload de replay é o corpo maior que o serviço aceita (o .rrf cru). O teto do
	# lado do Node é o mesmo — este aqui só evita que o corpo suba até lá para ser
	# recusado.
	request_body {
		max_size 8MB
	}

	# O que é do serviço Node vem ANTES do arquivo estático. Blocos `handle` são
	# mutuamente exclusivos e avaliados na ordem escrita, então nenhum arquivo em
	# /opt/latam-market-web tem como sequestrar /api, /mcp ou /healthz — nem por
	# acidente, nem por um deploy que suba um arquivo com esse nome.
	@backend path /api/* /mcp /healthz
	handle @backend {
		reverse_proxy 127.0.0.1:8788 {
			# O transporte MCP roda em modo JSON stateless, então não há nada a esvaziar
			# aos poucos. Mantido explícito para uma futura troca para SSE não passar a
			# bufferizar em silêncio.
			flush_interval -1

			transport http {
				# Folga para a requisição mais pesada que existe: um `.rrf` de alguns MB
				# subindo e sendo precificado item por item. Nenhuma rota espera rede de
				# terceiro — o serviço só lê o próprio banco.
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# O Vite carimba hash no nome de todo asset, e o build do catálogo faz o mesmo com as
	# descrições — os dois podem ser imutáveis. O HTML NÃO pode: é ele que aponta para os
	# hashes novos, e o `rsync --delete` do deploy apaga os antigos. Um índice cacheado
	# deixa o navegador pedindo assets que não existem mais — tela branca até o usuário
	# limpar o cache na mão.
	# As duas listas são complementares e precisam continuar assim: um prefixo novo de
	# asset com hash entra nos DOIS lugares. São dois matchers, e não um `header` solto
	# como padrão mais um override, porque assim nenhum dos dois depende da ordem em que o
	# Caddy resolve as diretivas — foi justamente uma dependência de ordem (`header` antes
	# de `try_files`) que deixou o HTML da 0.3.0 sem Cache-Control algum.
	@immutable path /assets/* /generated/*
	@html not path /assets/* /generated/*

	# A interface. Qualquer rota que não seja da API cai no index — o roteamento é do
	# lado do cliente (BrowserRouter).
	handle {
		root * /opt/latam-market-web

		# Os dois `header` moram DENTRO deste handle de propósito: no nível do site
		# eles também carimbariam as respostas da API e do MCP.
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# `@html` casa no caminho PEDIDO, não no arquivo servido. Um
		# `header /index.html` não funciona aqui: `header` corre antes de `try_files`
		# na ordem de diretivas do Caddy, então ele veria `/` e `/pechinchas` — que é
		# o que o navegador pede de fato — e deixaria o HTML sem Cache-Control algum,
		# livre para o cache heurístico do navegador.
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		# Os .br/.zst/.gz são gerados no build e enviados junto: recomprimir os 5 MB de
		# descrições a cada requisição gastaria CPU que esta máquina compartilhada não
		# tem de sobra, e o brotli estático rende 489 KB contra 736 KB do gzip.
		file_server {
			precompressed br zstd gzip
		}
	}

	# Sem bloco `log`: os acessos vão para o journal, como nos outros fragmentos desta
	# máquina (`journalctl -u caddy`). Escrever em arquivo exigiria que o processo do
	# Caddy já em execução enxergasse o diretório novo — o namespace de montagem dele é
	# anterior à criação, então só um restart resolveria, e restart derruba os outros
	# três sites que este mesmo Caddy serve.
}
