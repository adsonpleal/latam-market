{
  "name": "latam-market",
  "version": "0.7.1",
  "license": "MIT",
  "type": "module",
  "description": "API e servidor MCP para o mercado de jogadores do Ragnarok LATAM",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "node build.mjs",
    "import": "tsx src/cli/import-ndjson.ts",
    "sync:items": "node tools/sync-items.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
