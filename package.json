{
  "name": "latam-market",
  "version": "0.13.0",
  "license": "MIT",
  "type": "module",
  "description": "API, servidor MCP e coleta do mercado de jogadores do Ragnarok LATAM",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/node/index.ts",
    "start": "node dist/server.mjs",
    "build": "node build.mjs",
    "sync:items": "node tools/sync-items.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "tsx src/cli/build-catalogue-asset.ts",
    "pretest": "tsx src/cli/build-catalogue-asset.ts",
    "catalogue": "tsx src/cli/build-catalogue-asset.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "rrfparser": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
