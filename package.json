{
  "name": "latam-market",
  "version": "0.12.1",
  "license": "MIT",
  "type": "module",
  "description": "API e servidor MCP para o mercado de jogadores do Ragnarok LATAM",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "node build.mjs",
    "import": "tsx src/cli/import-ndjson.ts",
    "sync:items": "node tools/sync-items.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "pretypecheck": "wrangler types && tsx src/cli/build-catalogue-asset.ts",
    "pretest": "wrangler types && tsx src/cli/build-catalogue-asset.ts",
    "catalogue": "tsx src/cli/build-catalogue-asset.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "rrfparser": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
